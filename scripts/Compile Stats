#! /usr/bin/env python
###############################################################################################################################################################################################################################################################
# Updates the files that contain data extracted from the film
# Each wrestler has their own file
# The excel sheets that contain wrestler data can be found in the stats/wrestler_data folder where the file is named after the wrestler
###############################################################################################################################################################################################################################################################

from helpers import *
import os
import pandas as pd
from pathlib import Path
import logging  # Explicitly import logging for clarity


def Main() -> None:
    """Compile stats from all tagged videos and update wrestler CSV files.

    This function processes all videos in the `taged_dir`, extracts chapter
    data for each wrestler using `MakeNameAndCSV`, and then writes this
    compiled data into wrestler-specific CSV files in `csv_dir`.
    """

    logging.info("Starting Compile Stats script.")
    print("Starting to Compile Stats...")

    logging.debug(
        "Reading Wrestlers.config to initialize wrestler_to_csv_list.")
    # This uses a dict from wrestlers to lists to buffer file IO and avoid repeated concatenation
    with open(cfg_dir / "Wrestlers.config", "r") as wrestlers:
        lines: list[str] = list(filter(lambda string: not (
            len(string) == 0 or string[0] == '#'), wrestlers.read().splitlines()))

        wrestler_to_csv_list: dict[str, list[str]] = dict(
            [(line.split('#')[0].strip(), []) for line in lines])
    logging.info(
        f"Initialized wrestler_to_csv_list with {len(wrestler_to_csv_list)} wrestlers.")

    logging.info(f"Processing videos in {taged_dir}.")
    print(f"Processing videos...")

    processing_errors: list[str] = list()

    for vid_file in os.listdir(taged_dir):
        vid_path = taged_dir / vid_file
        logging.debug(f"Extracting chapter data from video: {vid_path}")
        try:
            (name, data) = MakeNameAndCSV(vid_path)
            if name in wrestler_to_csv_list:
                wrestler_to_csv_list[name].append(data)
                logging.debug(
                    f"Appended data for wrestler '{name}' from video '{vid_file}'.")
            else:
                logging.warning(
                    f"Wrestler '{name}' from video '{vid_file}' not found in Wrestlers.config. Skipping data.")
                processing_errors.append(
                    f"Skipped video '{vid_file}': Wrestler '{name}' not found in configuration.")
        except Exception as e:
            logging.error(f"Error processing video {vid_path}: {e}")
            processing_errors.append(
                f"Failed to process video '{vid_file}': {e}")

    wrestler_to_csv: dict[str, str] = {wrestler:
                                       "\n".join(data) for (wrestler, data) in wrestler_to_csv_list.items()}
    logging.info("Finished processing all videos. Compiling CSV strings.")
    print("Finished processing all videos.")

    logging.info(f"Writing compiled data to CSV files in {csv_dir}.")
    print(f"Writing compiled data to CSV files in '{csv_dir}'...")

    writing_errors: list[str] = list()

    for name, data in wrestler_to_csv.items():
        output_csv_path = (csv_dir / name).with_suffix(".csv")
        try:
            with open(output_csv_path, "w") as csv_file:
                csv_file.write(data)
            logging.info(
                f"Successfully wrote data for '{name}' to '{output_csv_path}'.")
        except IOError as e:
            logging.error(
                f"Failed to write CSV to '{output_csv_path}': {e}")
            writing_errors.append(
                f"Failed to write data to '{output_csv_path}': {e}")

    if processing_errors or writing_errors:
        print("\nCompile Stats finished with issues:")
        for err in processing_errors:
            print(f"  - {err}")
        for err in writing_errors:
            print(f"  - {err}")
    else:
        print("\nCompile Stats completed successfully.")

    logging.info("Compile Stats script finished.")


if __name__ == '__main__':
    Main()
