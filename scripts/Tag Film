#! /usr/bin/env python
###############################################################################################################################################################################################################################################################
# Select a video to interactively tag by adding chapters
# A chapter will consist of continuous action (hereby referred to as a sequence) and will end when the action stops
###############################################################################################################################################################################################################################################################
# ChapterSequences are made up of 5 main pieces of data:
# - Time: The timestamps (from the video not the match) of the start and end of a sequence
# - Attacker: Was your wrestler the one who made the first committed attack
# - Tie-up/Position: What was the position or tie-up that the sequence began in
# - Moves: What moves did each wrestler use
# - Scoring: How many points did each wrestler score and how
###############################################################################################################################################################################################################################################################

import subprocess
import os
import sys
from pathlib import Path
from helpers import *


def TagVideo(vid_file_name: str, wrestler_name: str, chap_list: list[ChapterSequence]):
    """
    Creates a new video with title and chapter metadata using ffmpeg, then hides the original.
    """
    vid_file: Path = Path(vid_file_name.strip())
    input_path: Path = untaged_dir / vid_file.name
    # Use mkv format because it is more fit for video concatenation
    output_path: Path = taged_dir / vid_file.with_suffix(".mkv").name
    metadata_path: Path = tmp_dir / "metadata.txt"

    print(f"\nGenerating metadata for: {vid_file_name}")

    # 1. Create the ffmpeg metadata file content
    metadata_content = f";FFMETADATA1\ntitle={wrestler_name.strip()}\n\n"
    for chap in chap_list:
        metadata_content += chap.ToMetadata()

    # Write metadata to a temporary file
    with open(metadata_path, "w") as f:
        f.write(metadata_content)

    print("Applying metadata with ffmpeg...")

    # 2. Construct and run the ffmpeg command
    command = [
        "ffmpeg",
        "-i", str(input_path),
        "-i", str(metadata_path),
        "-map_metadata", "1",
        "-codec", "copy",
        "-y",  # Overwrite output file if it exists
        output_path,
    ]

    try:
        # Hide ffmpeg's default verbose output, show it only on error
        result = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True
        )

        # 3. Cleanup successful run
        os.remove(metadata_path)
        os.rename(input_path, f"{input_path.parent}/.{vid_file_name}")
        print("\nSuccessfully tagged video and hid original.")

    except subprocess.CalledProcessError as e:
        print("\nAn error occurred during ffmpeg processing:", file=sys.stderr)
        print(f"Command: {' '.join(command)}", file=sys.stderr)
        print(f"ffmpeg stderr:\n{e.stderr}", file=sys.stderr)
        # Clean up the failed output file but keep metadata for debugging
        if os.path.exists(output_path):
            os.remove(output_path)
        sys.exit(1)
    except Exception as e:
        print(f"\nAn unexpected error occurred: {e}", file=sys.stderr)
        sys.exit(1)


def VideoSelect() -> str:
    return subprocess.run(
        "ls ./vids/untaged/ | fzf --header='Select the Video You Want to Tag\n"
        "WARNING: This file will be hidden and a new one will be created in the `taged` folder' "
        "--header-border=bold --header-label-pos=top --no-multi",
        shell=True,
        capture_output=True,
        text=True,
        check=True  # Raises a CalledProcessError if the command returns a non-zero exit code
    ).stdout.strip()


def AskToContinue(chap_in: ChapterSequence) -> str:
    with open("tmp/tmp_chap.txt", "w") as file:
        file.write(chap_in.PretyChapter())
    return subprocess.run(
        "echo 'Re-do Sequence\nNew Sequence\nDone' | fzf --header='Do you have new sequences to add?' "
        f"--header-border=bold --header-label-pos=top --no-multi --preview='cat tmp/tmp_chap.txt'",
        shell=True,
        capture_output=True,
        text=True,
        check=True  # Raises a CalledProcessError if the command returns a non-zero exit code
    ).stdout.strip()


def main() -> None:
    vid_file_name: str = VideoSelect()

    wrestler_name: str = SelectFromConfig("Wrestlers.config",
                                          "Select the wrestler from your team.")

    chap_list: list[ChapterSequence] = list()

    what_to_do: str = "New Sequence"
    old_end: int = 0  # this variable is used to make the filler chapters
    while (what_to_do != "Done"):
        start: int = GetTime("Enter the START time in this format mins:secs\t")

        attacking: bool = "Attacking" == subprocess.run(
            "echo 'Attacking\nDefending' | fzf --header='Was YOUR wrestler initially attacking or defending?' "
            "--header-border=bold --header-label-pos=top --no-multi",
            shell=True,
            capture_output=True,
            text=True,
            check=True  # Raises a CalledProcessError if the command returns a non-zero exit code
        ).stdout

        tie: str = SelectFromConfig("Ties.config",
                                    "What was the inital position/tie-up?\n"
                                    "From The Perspective of YOUR wrestler.").removesuffix("\n")

        our_moves: list[str] = SelectMultiFromConfig(
            "Moves.config",
            "Select the moves YOUR wrestler used in the sequence.\n"
            "Use tab to select multiple moves."
            # Allows for move names to be multiple words
        ).removesuffix("\n").split(sep="\n")

        other_moves: list[str] = SelectMultiFromConfig(
            "Moves.config",
            "Select the moves the OPPONENT used in the sequence.\n"
            "Use tab to select multiple moves."
        ).removesuffix("\n").split(sep="\n")

        our_seq: list[str] = SelectMultiFromConfig(
            "Outcomes.config",
            "What points did YOUR wrestler score?").removesuffix("\n").split(sep="\n")

        other_seq: list[str] = SelectMultiFromConfig(
            "Outcomes.config",
            "What points did the OPPONENT score?").removesuffix("\n").split(sep="\n")

        end: int = GetTime("Enter the END time in this format mins:secs\t")

        temp_chap: ChapterSequence = ChapterSequence(start_time=start,
                                                     end_time=end,
                                                     attack_defend=attacking,
                                                     tie_up=tie,
                                                     team_moves=our_moves,
                                                     op_moves=other_moves,
                                                     team_scores=our_seq,
                                                     op_scores=other_seq)

        what_to_do = AskToContinue(temp_chap)

        if what_to_do != "Re-do Sequence":
            chap_list.append(ChapterSequence.MakeEmptyChap(old_end, start))
            chap_list.append(temp_chap)
            old_end = end

     # Cap off the list with an empty Chapter to finish the list
    chap_list.append(
        ChapterSequence.MakeEmptyChap(
            old_end,
            GetVidDuration(
                untaged_dir / vid_file_name
            )
        )
    )

# After collecting all chapters, process the video
    if chap_list:
        TagVideo(vid_file_name, wrestler_name, chap_list)
    else:
        print("No chapters were added. No new video file created.")


if __name__ == '__main__':
    Main()
