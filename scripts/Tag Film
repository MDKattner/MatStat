#! /usr/bin/env python
# DEPRECATED: MatStat CLI is deprecated; use the Qt6 GUI (python scripts/qt_app/main.py).
###############################################################################################################################################################################################################################################################
# Select a video to interactively tag by adding chapters
# A chapter will consist of continuous action (hereby referred to as a sequence) and will end when the action stops
###############################################################################################################################################################################################################################################################
# ChapterSequences are made up of 5 main pieces of data:
# - Time: The timestamps (from the video not the match) of the start and end of a sequence
# - Attacker: Was your wrestler the one who made the first committed attack
# - Tie-up/Position: What was the position or tie-up that the sequence began in
# - Moves: What moves did each wrestler use
# - Scoring: How many points did each wrestler score and how
###############################################################################################################################################################################################################################################################

import subprocess
import os
import sys
import logging
from pathlib import Path
from helpers import *
from typing import TextIO


logging.info("Starting Tag Film script.")


def TagVideo(vid_file_name: str, wrestler_name: str, chap_list: list[ChapterSequence]) -> None:
    """Create a new video with embedded chapter metadata.

    This function uses ffmpeg to create a new .mkv video file that includes
    the wrestler's name as the title and the tagged sequences as chapters.
    On success, the original video file is hidden by prepending a '.' to its name.

    Args:
        vid_file_name: The name of the original video file in ./vids/untaged/.
        wrestler_name: The name of the wrestler to be set as the video title.
        chap_list: A list of ChapterSequence objects to be written as metadata.
    """
    logging.info(
        f"Tagging video: {vid_file_name} for wrestler: {wrestler_name}")
    vid_file: Path = Path(vid_file_name.strip())
    input_path: Path = untaged_dir / vid_file.name
    output_path: Path = taged_dir / vid_file.with_suffix(".mkv").name
    metadata_path: Path = tmp_dir / "metadata.txt"

    logging.debug(
        f"Input path: {input_path}, Output path: {output_path}, Metadata path: {metadata_path}")

    metadata_content: str = f";FFMETADATA1\ntitle={wrestler_name.strip()}\n\n"
    for chap in chap_list:
        metadata_content += chap.ToMetadata()
    logging.debug("Generated ffmpeg metadata content.")

    with open(metadata_path, "w") as f:
        f.write(metadata_content)
    logging.info(f"Wrote metadata to temporary file: {metadata_path}")

    command: list[str] = [
        "ffmpeg",
        "-i", str(input_path),
        "-i", str(metadata_path),
        "-map_metadata", "1",
        "-codec", "copy",
        "-y",  # Overwrite output file if it exists
        str(output_path),
    ]
    logging.debug(f"Executing ffmpeg command: {' '.join(command)}")

    try:
        result: subprocess.CompletedProcess[str] = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True
        )
        logging.debug(f"ffmpeg stdout:\n{result.stdout}")

        os.remove(metadata_path)
        os.rename(input_path, f"{input_path.parent}/.{vid_file_name}")
        logging.info(
            f"Successfully tagged video '{vid_file_name}' and hid original.")
        print("\nSuccessfully tagged video and hid original.")

    except subprocess.CalledProcessError as e:
        logging.error(
            f"An error occurred during ffmpeg processing for '{vid_file_name}':")
        logging.error(f"Command: {' '.join(map(str, command))}")
        logging.error(f"ffmpeg stderr:\n{e.stderr}")
        print("\nAn error occurred during ffmpeg processing:",
              file=sys.stderr)  # User-facing error
        print(f"Command: {' '.join(map(str, command))}", file=sys.stderr)
        print(f"ffmpeg stderr:\n{e.stderr}", file=sys.stderr)
        if os.path.exists(output_path):
            os.remove(output_path)
            logging.warning(
                f"Removed partially created output file: {output_path}")
        sys.exit(1)
    except Exception as e:
        logging.error(
            f"An unexpected error occurred during tagging '{vid_file_name}': {e}")
        print(f"\nAn unexpected error occurred: {e}", file=sys.stderr)
        sys.exit(1)


def VideoSelect() -> str:
    """Display an fzf menu to select a video from the untagged directory.

    The user is warned that the selected video will be hidden.

    Returns:
        The file name of the video selected by the user.
    """
    fzf_cmd: str = (  # Does not work if split into a list
        "ls ./vids/untaged/ | fzf --header='Select the Video You Want to Tag\n"
        "WARNING: This file will be hidden and a new one will be created in the `taged` folder' "
        "--header-border=bold --header-label-pos=top --no-multi"
    )

    while True:
        try:
            logging.debug(
                f"Executing fzf command for video selection: {fzf_cmd}")
            selected_video: str = subprocess.run(
                fzf_cmd,
                shell=True,
                capture_output=True,
                text=True,
                check=True
            ).stdout.strip()
            logging.info(f"Selected video for tagging: '{selected_video}'")
            return selected_video
        except subprocess.CalledProcessError:
            logging.info("No video selected, exiting")
            print("No video selected, exiting")
            sys.exit(0)


def AskToContinue(chap_in: ChapterSequence) -> str:
    """Display an fzf menu asking the user how to proceed after tagging a sequence.

    The user can choose to re-do the last sequence, start a new one, or finish the tagging process.
    A preview of the most recently tagged sequence is shown to the user.

    Args:
        chap_in: The ChapterSequence object of the most recently tagged sequence.

    Returns:
        The user's choice: "Re-do Sequence", "New Sequence", or "Done".
    """
    logging.debug(
        f"Asking user to continue after sequence: {chap_in.PrettyChapter()}")
    with open(tmp_dir / "tmp_chap.txt", "w") as file:
        file.write(chap_in.PrettyChapter())

    fzf_cmd: str = (
        "echo 'Re-do Sequence\nNew Sequence\nDone' | fzf --header='Do you have new sequences to add?' "
        f"--header-border=bold --header-label-pos=top --no-multi --preview='cat {tmp_dir}/tmp_chap.txt'"
    )

    logging.debug(f"Executing fzf command for continuation: {fzf_cmd}")
    user_choice: str = subprocess.run(
        fzf_cmd,
        shell=True,
        capture_output=True,
        text=True,
        check=True
    ).stdout.strip()
    logging.info(f"User chose to: '{user_choice}'")
    return user_choice


def AskIfAttacking() -> bool:
    """Prompts the user to select if their wrestler was attacking then returns the answer as a bool

    Returns:
        `True` if attacking, otherwise `False`
    """
    attacking_fzf_cmd: str = (
        "echo 'Attacking\nDefending' | fzf --header='Was YOUR wrestler initially attacking or defending?' "
        f"--header-border=bold --header-label-pos=top --no-multi"
    )
    logging.debug(
        f"Executing fzf command for attacking/defending: {attacking_fzf_cmd}")
    attacking_str: str = subprocess.run(
        attacking_fzf_cmd,
        shell=True,
        capture_output=True,
        text=True,
        check=True
    ).stdout.strip()
    return (attacking_str == "Attacking")


def Main() -> None:
    """Run the main interactive video tagging process.

    This function guides the user through selecting a video, identifying wrestlers,
    and interactively defining action sequences as chapters within the video.
    It collects all chapter metadata and then calls TagVideo to apply them to the video.
    """
    logging.info("Starting main tagging process.")
    logging.warning("DEPRECATED: MatStat CLI is deprecated; use the Qt6 GUI (python scripts/qt_app/main.py).")
    print("NOTE: MatStat CLI is deprecated. Use the Qt6 GUI instead: python scripts/qt_app/main.py", file=sys.stderr)

    vid_file_name: str = VideoSelect()
    if vid_file_name == "":
        print("No video selected, restarting")
        logging.info("No video selected, restarting")
        sys.exit(0)  # Non-error exit code because this is normal usage

    logging.info(f"User selected video: {vid_file_name}")
    print(f"Adding data to: {untaged_dir / vid_file_name}")

    wrestler_name: str = SelectFromConfig("Wrestlers.config",
                                          "Select the wrestler from your team.")
    if wrestler_name == "":
        print("No wrestler selected, restarting")
        logging.info("No wrestler selected, restarting")
        sys.exit(0)  # Non-error exit code because this is normal usage

    logging.info(f"User selected wrestler: {wrestler_name}")

    chap_list: list[ChapterSequence] = list()

    what_to_do: str = "New Sequence"
    old_end: int = 0  # this variable is used to make the filler chapters
    while (what_to_do != "Done"):
        logging.info("Starting new sequence tagging loop.")
        start: int = GetTimeFromUsr(
            "Enter the START time in this format mins:secs\t")
        logging.debug(f"Sequence start time: {start}")

        attacking: bool = AskIfAttacking()
        logging.info(
            f"Wrestler was attacking: {attacking}")

        tie: str = ""
        while not tie:
            tie = SelectFromConfig("Ties.config",
                                   "What was the inital position/tie-up?\n"
                                   "From The Perspective of YOUR wrestler.").removesuffix("\n")
            if not tie:
                logging.warning(
                    "User made no selection for tie-up. Re-prompting.")
        logging.info(f"Selected tie-up: {tie}")

        our_moves: list[str] = ['']
        while our_moves == ['']:
            our_moves_str: str = SelectMultiFromConfig(
                "Moves.config",
                "Select the moves YOUR wrestler used in the sequence.\n"
                "Use tab to select multiple moves."
            ).removesuffix("\n")
            our_moves = our_moves_str.split(sep="\n")
            if our_moves == ['']:
                logging.warning(
                    "User made no selection for team moves. Re-prompting.")
        logging.info(f"Your wrestler's moves: {our_moves}")

        other_moves: list[str] = ['']
        while other_moves == ['']:
            other_moves_str: str = SelectMultiFromConfig(
                "Moves.config",
                "Select the moves the OPPONENT used in the sequence.\n"
                "Use tab to select multiple moves."
            ).removesuffix("\n")
            other_moves = other_moves_str.split(sep="\n")
            if other_moves == ['']:
                logging.warning(
                    "User made no selection for opponent moves. Re-prompting.")
        logging.info(f"Opponent's moves: {other_moves}")

        our_seq_str: str = SelectMultiFromConfig(
            "Outcomes.config",
            "What points did YOUR wrestler score?").removesuffix("\n")
        our_seq: list[str] = our_seq_str.split(
            sep="\n") if our_seq_str else ["None"]
        logging.info(f"Your wrestler's scores: {our_seq}")

        other_seq_str: str = SelectMultiFromConfig(
            "Outcomes.config",
            "What points did the OPPONENT score?").removesuffix("\n")
        other_seq: list[str] = other_seq_str.split(
            sep="\n") if other_seq_str else ["None"]
        logging.info(f"Opponent's scores: {other_seq}")

        end: int = GetTimeFromUsr(
            "Enter the END time in this format mins:secs\t")
        logging.debug(f"Sequence end time: {end}")

        temp_chap: ChapterSequence = ChapterSequence(start_time=start,
                                                     end_time=end,
                                                     attack_defend=attacking,
                                                     tie_up=tie,
                                                     team_moves=our_moves,
                                                     op_moves=other_moves,
                                                     team_scores=our_seq,
                                                     op_scores=other_seq)
        logging.debug(f"Created temporary chapter: {temp_chap}")

        what_to_do = AskToContinue(temp_chap)

        if what_to_do != "Re-do Sequence":
            logging.debug(
                f"Appending filler chapter from {old_end} to {start}")
            chap_list.append(ChapterSequence.MakeEmptyChap(old_end, start))
            logging.debug(f"Appending tagged chapter: {temp_chap}")
            chap_list.append(temp_chap)
            old_end = end
        else:
            logging.info(
                "User chose to re-do sequence. Current chapter not appended.")

    logging.info("Finished collecting all chapters from user input.")
    # Cap off the list with an empty Chapter to finish the list
    video_duration: int = GetVidDuration(
        untaged_dir / vid_file_name
    )
    logging.debug(
        f"Appending final filler chapter from {old_end} to video end ({video_duration})")
    chap_list.append(
        ChapterSequence.MakeEmptyChap(
            old_end,
            video_duration
        )
    )

    # After collecting all chapters, process the video
    if chap_list:
        logging.info(
            f"Processing video '{vid_file_name}' with {len(chap_list)} chapters.")
        TagVideo(vid_file_name, wrestler_name, chap_list)
    else:
        logging.info("No chapters were added. No new video file created.")
        # Keep print for immediate user feedback
        print("No chapters were added. No new video file created.")


if __name__ == '__main__':
    Main()
