#! /usr/bin/env python
###############################################################################################################################################################################################################################################################
# Creates excel spreadsheet and advanced stats from the complied CSV files
# It compiles everything into a single excel file with multiple sheets
###############################################################################################################################################################################################################################################################

import pandas as pd
from helpers import *
from pathlib import Path
import logging
import sys  # Import sys for stderr and exit


def Main() -> None:
    """Generate a multi-sheet Excel report of advanced wrestling stats.

    This script processes each wrestler's compiled CSV file from the
    `stats/wrestler_data` directory, generates several statistical
    DataFrames (Initiation, Defense, Offense), and writes them all into
    separate sheets of a single Excel file located in `stats/reports`.
    """

    logging.info("Starting Team Evaluation script.")
    print("Starting Team Evaluation...")

    excel_file: Path = eval_dir / "Team_Stats.xlsx"
    logging.info(f"Output Excel file will be generated at: {excel_file}")
    print(f"Output will be saved to: '{excel_file}'")

    evaluation_errors: list[str] = list()

    try:
        with pd.ExcelWriter(
            excel_file,
            engine="openpyxl",
            mode="w"
        ) as writer:
            csv_files: list[Path] = [
                path for path in csv_dir.glob('*.csv') if path.name != "UNKNOWN.csv"
            ]
            logging.info(
                f"Found {len(csv_files)} wrestler CSV file(s) to process.")
            print(
                f"Found {len(csv_files)} file(s) of wrestler data to process.")

            if not csv_files:
                print("No wrestler data files found in 'stats/wrestler_data/'. Exiting.")
                logging.info("No wrestler data files found. Exiting.")
                sys.exit(1)

            for csv_file in csv_files:
                sheet_name: str = csv_file.stem
                logging.debug(
                    f"Processing '{csv_file}' for sheet '{sheet_name}'.")
                print(f"  - Processing data for '{sheet_name}'...")

                try:
                    tmp_df: pd.DataFrame = MakeFormattedDataFrame(csv_file)

                    logging.debug(
                        f"Generating and writing Initiation DF for '{sheet_name}'.")
                    GenerateInitiationDF(tmp_df).to_excel(
                        writer, sheet_name=sheet_name)

                    logging.debug(
                        f"Generating and writing Defense DF for '{sheet_name}'.")
                    GenerateDefenseDF(tmp_df).to_excel(
                        writer, sheet_name=sheet_name, startrow=4)

                    logging.debug(
                        f"Generating and writing Offense DF for '{sheet_name}'.")
                    GenerateOffenseDF(tmp_df).to_excel(
                        writer, sheet_name=sheet_name, startrow=4, startcol=8)

                    logging.debug(f"Writing raw data DF for '{sheet_name}'.")
                    tmp_df.to_excel(
                        writer, sheet_name=sheet_name, startrow=4, startcol=16)

                    logging.info(
                        f"Successfully wrote all data for sheet '{sheet_name}'.")
                    print(f"    Data for '{sheet_name}' written to Excel.")

                except Exception as e:
                    logging.error(
                        f"Failed to process file '{csv_file}' for sheet '{sheet_name}': {e}")
                    evaluation_errors.append(
                        f"Failed to process '{csv_file}' for '{sheet_name}': {e}")

        logging.info(f"Successfully generated Excel report: {excel_file}")
        if not evaluation_errors:
            print("\nTeam Evaluation completed successfully.")
        else:
            print("\nTeam Evaluation finished with some errors:")
            for err in evaluation_errors:
                print(f"  - {err}")

    except Exception as e:
        logging.error(
            f"Failed to create or write to Excel file {excel_file}: {e}")
        print(
            f"\nAn error occurred during Excel report generation: {e}", file=sys.stderr)
        sys.exit(1)

    logging.info("Team Evaluation script finished.")


if __name__ == '__main__':
    Main()
